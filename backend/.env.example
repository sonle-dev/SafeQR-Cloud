# SafeQR-Cloud Backend Environment Variables

# Server config
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=*

# Upstash Redis (In-Memory Cache & Velocity Counter)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Neon Serverless PostgreSQL Database
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/safeqr_db?sslmode=require

# Telegram Emergency Alert Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
DEFAULT_GUARDIAN_CHAT_ID=your_telegram_chat_id_for_testing
